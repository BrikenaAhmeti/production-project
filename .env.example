# Supabase Dashboard → Connect → Transaction pooler for Vercel.
DATABASE_URL=
# Optional direct or session pooler connection for the local migration command.
DATABASE_MIGRATION_URL=
# Optional PEM certificate from your database provider for TLS verification.
DATABASE_CA_CERT=

ADMIN_EMAIL=admin@go-production.local
ADMIN_PASSWORD=
SESSION_SECRET=
# Used only by the authenticated database health endpoint.
CRON_SECRET=

# Public URL of the deployed site. Omit for localhost.
APP_ORIGIN=
STUDIO_TIMEZONE=Europe/Belgrade

# Use your provider's SMTP credentials and a verified From address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
